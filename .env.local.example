# VantaUM Clinical Brief Engine — Environment Variables
# Copy to .env.local and fill in values.
# Never commit real credentials. Empty values = demo mode.

# ── Demo (zero secrets) ──────────────────────────────────────────────────────
# Leave everything blank and run `npm run dev`.
# Or force fixtures even when a database is configured:
# NEXT_PUBLIC_DEMO_MODE=true

# ── Path A — AWS / RDS (destination of truth) ────────────────────────────────
# Local Postgres: docker compose -f docker-compose.postgres.yml up -d
# Then: npm run db:migrate:rds
ENABLE_AWS_DB=false
DATABASE_URL=
# Or individual fields (Fargate mounts these from Secrets Manager):
DB_HOST=
DB_PORT=5432
DB_NAME=vantaum
DB_USER=
DB_PASSWORD=
# Local docker: DATABASE_SSL=disable
DATABASE_SSL=

ENABLE_AWS_STORAGE=false
AWS_S3_BUCKET_PREFIX=vantaum-prod-
AWS_REGION=us-east-1

ENABLE_AWS_EMAIL=false
SES_FROM_ADDRESS=
SES_CONFIGURATION_SET=

# Cognito auth cutover (Phase 0.2). DEFAULT FALSE — leave it off unless
# you are deliberately running the AWS auth path.
#
# ENABLE_AWS_AUTH=true (local/staging):
#   Password login  → POST /api/auth/sign-in → Cognito ADMIN_USER_PASSWORD_AUTH
#                     Sets HttpOnly `vantaum_session`. No supabase.auth.signInWithPassword.
#   Magic link      → AuthAdminAdapter → custom-auth Lambdas + /api/auth/callback
#   Team invite     → Cognito createUserWithMagicLink + user_profiles upsert
#   AuthProvider    → GET /api/auth/session (adapter JWKS). Not Supabase SSR cookies.
#   Middleware      → vantaum_session only. Leftover sb-* cookies are ignored.
#
# ENABLE_AWS_AUTH=false (default, including Fargate unless you export the
# flag at `cdk deploy`):
#   Existing Supabase Auth hybrid. POST /api/auth/sign-in returns 503
#   `{ backend: "supabase" }` even if COGNITO_* ids are present on the
#   task, so leftover pool ids cannot hijack login.
#
# Still Supabase / leftover after this flag:
#   Bootstrap/seed scripts (construct a Supabase JS client)
#   Optional NEXT_PUBLIC_SUPABASE_* if you keep the hybrid path
#   user_profiles role lookup (RDS or Supabase Postgres — not Auth)
#
# Staging enable (synthetic users only — no live PHI):
#   ENABLE_AWS_AUTH=true
#   COGNITO_USER_POOL_ID / COGNITO_CLIENT_ID / COGNITO_REGION
#   APP_URL=https://app.vantaum.com   (magic-link landing)
#   ComputeStack already injects the prod pool ids; flip the flag at deploy:
#     ENABLE_AWS_AUTH=true npx cdk deploy vantaum-prod-compute
ENABLE_AWS_AUTH=false
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
# SESSION_STASH_TABLE=vantaum-prod-auth-session-stash

# ── Path B — Supabase leftover (Vercel cutover only) ─────────────────────────
# Omit all three for demo mode. Do not set these on Fargate if ENABLE_AWS_DB=true
# unless you still need Supabase Auth (V1 hybrid).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API (required for AI brief generation)
ANTHROPIC_API_KEY=

# Sentry Error Monitoring (optional)
SENTRY_DSN=

# Webhook Security
WEBHOOK_SECRET=

# External API Key (for /api/external/submit)
VANTAHG_API_KEY=

# SMTP Email (nodemailer — works with SendGrid, Resend, SES, Mailgun, etc.)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM=VantaUM <noreply@vantaum.com>

# Admin notifications (SLA escalations, system alerts)
ADMIN_NOTIFICATION_EMAIL=

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Application URL (for links in emails)
NEXTAUTH_URL=https://app.vantaum.com

# Credential encryption key (32-byte hex string for AES-256-GCM)
CREDENTIAL_ENCRYPTION_KEY=

# ── Gravity Rail ──────────────────────────────────────────────────────────────
# Sign up at https://app.gravityrail.com/get-started (PAYG, credit card required)
# API key docs: https://docs.gravityrail.com/developer/guides/authentication#creating-an-api-key

# Server-side only (never expose to browser)
GRAVITY_RAIL_API_KEY=

# Default workspace UUID — shown in your GR dashboard URL
GRAVITY_RAIL_WORKSPACE_ID=

# Demo preview password protection (set in Vercel → Settings → Environment Variables)
# Only share this with people you want to see the exclusive demo.
DEMO_PASSWORD=

# Client-side (safe to expose — these are public identifiers, not secrets)
NEXT_PUBLIC_GRAVITY_RAIL_WORKSPACE_ID=
NEXT_PUBLIC_GRAVITY_RAIL_SITE_ID=
NEXT_PUBLIC_GRAVITY_RAIL_WORKFLOW_SLUG=member-support

# ── Dropbox Sign (formerly HelloSign) ─────────────────────────────────────────
# API key from https://app.hellosign.com/home/myAccount#api
# Client ID (App ID) from the same page — required for webhook signature verification.
# Sign requests run in Dropbox-Sign test mode automatically when NODE_ENV != production.
# Set ENABLE_REAL_HELLOSIGN=true to actually hit the API (otherwise demo stub returns).
HELLOSIGN_API_KEY=
HELLOSIGN_CLIENT_ID=
ENABLE_REAL_HELLOSIGN=false
